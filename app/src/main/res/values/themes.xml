<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge, no ActionBar: matches the iOS NavigationStack chrome. -->
    <style name="Theme.SEUWiki" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/grouped_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
