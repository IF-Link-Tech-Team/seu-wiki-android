<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SEUWiki"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          launchMode=singleTask：登录回调后要把既有 MainActivity 带回前台，
          CLEAR_TOP 才有实例可复用，否则会多出一个空的 MainActivity 压在原界面上。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SEUWiki"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          OIDC 回调落点，对应 iOS Info.plist 的 CFBundleURLTypes。

          下面挂两个 intent-filter，优先命中的是**已验证的 https**（App Link）：

          - https + autoVerify：系统安装时抓 https://seu.wiki/.well-known/assetlinks.json
            确认这个域名属于本 App，校验通过后回调直接进 App，不再弹
            「callback 想要打开外部应用 SEU.wiki」的确认框。校验不通过时
            https 会被退化成普通网页打开，所以 AuthStore 会先查域校验状态再决定用哪个。
          - custom scheme：Android 11 及以下、以及域校验还没跑完时的兜底路径。
            这条不能删，否则这些设备上根本登录不了。

          scheme/host 必须与 AuthConfig 里的 REDIRECT_SCHEME / APP_LINK_HOST 一致。

          singleTask + noHistory：Custom Tab 属于浏览器所在的任务栈，本 Activity 由浏览器
          派发，若不留 noHistory，finish() 之后会重新露出下面的 Custom Tab —— 表现为
          「登录其实成功了，但眼前只剩一片浏览器黑屏」。noHistory 让它处理完即出栈，
          真正的「回到 App」由 [AuthCallbackActivity] 显式拉起 MainActivity 完成。
          excludeFromRecents：它不渲染任何 UI，不该出现在最近任务里。
        -->
        <activity
            android:name=".AuthCallbackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.SEUWiki">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="seu.wiki"
                    android:pathPrefix="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="tech.iflink.seuwiki"
                    android:host="callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
