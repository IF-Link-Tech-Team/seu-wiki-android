<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地提醒：API 33+ 弹窗要用户授权，34+ 精确闹钟另需这一项 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SEUWiki"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          本地提醒：AlarmManager 到点唤起 ReminderReceiver 发系统通知。

          不是 exported —— 只有本应用才该拉起它；导出后任何 App 都能伪造一条
          ACTION_FIRE 广播，凭空弹出通知。

          没有注册 BOOT_COMPLETED 接收器是有意的：静态开机广播属于 Google Play
          的白名单特权，普通应用申请不到。开机后靠冷启动时的
          `UserProfileStore.reconcileReminderAlarms()` 对账补回闹钟。
        -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!--
          launchMode=singleTask：登录回调后要把既有 MainActivity 带回前台，
          CLEAR_TOP 才有实例可复用，否则会多出一个空的 MainActivity 压在原界面上。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SEUWiki"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          OIDC 回调落点，对应 iOS Info.plist 的 CFBundleURLTypes。

          下面挂两个 intent-filter，优先命中的是**已验证的 https**（App Link）：

          - https + autoVerify：系统安装时抓 https://seu.wiki/.well-known/assetlinks.json
            确认这个域名属于本 App，校验通过后回调直接进 App，不再弹
            「callback 想要打开外部应用 SEU.wiki」的确认框。校验不通过时
            https 会被退化成普通网页打开，所以 AuthStore 会先查域校验状态再决定用哪个。
          - custom scheme：Android 11 及以下、以及域校验还没跑完时的兜底路径。
            这条不能删，否则这些设备上根本登录不了。

          scheme/host 必须与 AuthConfig 里的 REDIRECT_SCHEME / APP_LINK_HOST 一致。

          singleTask：Custom Tab 属于浏览器所在的任务栈，本 Activity 由浏览器
          派发，复用既有实例避免回调重放时堆叠多个实例。
          excludeFromRecents：它不渲染任何 UI，不该出现在最近任务里。

          这里**刻意不再用 noHistory**（A-5）：换 token 的协程改挂在 [AuthStore] 的
          应用级 scope 上，不再依赖本 Activity 的生命周期；而 noHistory 的语义是
          「一旦不可见就 finish 自己」，用户切出去看一眼短信验证码再切回来，
          本 Activity 已经被销毁，那次 code 交换连同已清理的 PKCE 材料一起没了，
          回到 App 只剩一句「登录会话已失效」。透明主题则保证从浏览器切进来时
          不会闪一下白底。
          真正的「回到 App」由 [AuthCallbackActivity] 显式拉起 MainActivity 完成。
        -->
        <activity
            android:name=".AuthCallbackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SEUWiki.Transparent">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="seu.wiki"
                    android:pathPrefix="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="tech.iflink.seuwiki"
                    android:host="callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
